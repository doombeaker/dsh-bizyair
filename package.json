{
  "name": "dsh-bizyair",
  "version": "0.11.0",
  "description": "Every frontier image, video and audio model — open and closed source — in one AIGC creation platform inside DeepSeek Harness. A new account's credit is worth about 200 images, 3 short videos or 100 minutes of speech.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "data/catalog.json",
    "scripts/build-catalog.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/",
    "screenshots.json",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bizyair",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "media"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:index": "node scripts/build-index.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/impl.js && node --check lib/api.js && node --check lib/catalog.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doombeaker/dsh-bizyair.git"
  },
  "homepage": "https://github.com/doombeaker/dsh-bizyair",
  "author": "doombeaker"
}
